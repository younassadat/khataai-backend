# --- Meta WhatsApp Business Cloud API ---
WHATSAPP_TOKEN=your_permanent_or_temp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here
WHATSAPP_API_VERSION=v20.0

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=receipts

# --- Internal ---
# Any random string. Must match the header Supabase pg_cron sends (see schema.sql).
CRON_SECRET=choose_another_random_string_here

# Phase 1: daily receipt limit per beta user (default: 20)
DAILY_RECEIPT_LIMIT=20
