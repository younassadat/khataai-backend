# ── Green API (WhatsApp) ───────────────────────────────────────────────────
GREEN_API_INSTANCE_ID=     # From console.green-api.com — your instance ID
GREEN_API_TOKEN=           # From console.green-api.com — your API token

# ── Gemini API ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# ── Rate limiting ──────────────────────────────────────────────────────────
DAILY_RECEIPT_LIMIT=20

# ── Cron secret ────────────────────────────────────────────────────────────
CRON_SECRET=
